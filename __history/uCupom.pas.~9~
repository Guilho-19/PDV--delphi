unit uCupom;

interface

uses
  Winapi.Windows, Winapi.Messages, System.SysUtils, System.Variants, System.Classes, Vcl.Graphics,
  Vcl.Controls, Vcl.Forms, Vcl.Dialogs, Vcl.StdCtrls;

type
  TfrmCupom = class(TForm)
    memCupom: TMemo;
    Button1: TButton;
  private
    { Private declarations }
  public
    { Public declarations }
    procedure GerarCupom(AIdVenda: Integer);
  end;

var
  frmCupom: TfrmCupom;

implementation

{$R *.dfm}

uses uDMConexao;

{ TfrmCupom }

procedure TfrmCupom.GerarCupom(AIdVenda: Integer);
var
  Linha: string;
  ItemCont: Integer;
begin
  memCupom.Lines.Clear;

  memCupom.Lines.Add('========================================');
  memCupom.Lines.Add('          MERCADO CENTRAL LTDA          ');
  memCupom.Lines.Add('      Rua Principal, 123 - Centro       ');
  memCupom.Lines.Add('========================================');
  memCupom.Lines.Add(Format('CUPOM ELETRONICO NR: %06d', [AIdVenda]));
  memCupom.Lines.Add('DATA/HORA: ' + DateTimeToStr(Now));
  memCupom.Lines.Add('----------------------------------------');
  memCupom.Lines.Add('ITEM COD      DESCRICAO                 ');
  memCupom.Lines.Add('     QTD  x   VL.UNIT            SUBTOTAL');
  memCupom.Lines.Add('----------------------------------------');

  dmConexao.qryGravarVenda.Close;
  dmConexao.qryGravarVenda.SQL.Clear;

  dmConexao.qryGravarVenda.SQL.Add('select i.*, p.descricao from PDV_VendasItens i');
  dmConexao.qryGravarVenda.SQL.Add('inner join PDV_Produtos p on (p.codigo_barras = i.codigo_barras');
  dmConexao.qryGravarVenda.SQL.Add('where i.id_venda = :id');
  dmConexao.qryGravarVenda.Parameters.ParamByName('id').Value := AIdVenda;
  dmConexao.qryGravarVenda.Open;

  ItemCont := 1;
  while not dmConexao.qryGravarVenda.Eof do
  begin
    Linha := Format('%03d %-10s %-22s', [
      ItemCont,
      dmConexao.qryGravarVenda.FieldByName('codigo_barras').AsString,
      Copy(dmConexao.qryGravarVenda.FieldByName('descricao').AsString, 1, 22)
    ]);
    memCupom.Lines.Add(Linha);

    Linha := Format('     %5.2f x %-12s %14s', [
      dmConexao.qryGravarVenda.FieldByName('quantidade').AsFloat,
      FormatFloat('#,##0.00', dmConexao.qryGravarVenda.FieldByName('valor_unitario').AsFloat),
      FormatFloat('#,##0.00', dmConexao.qryGravarVenda.FieldByName('valor_subtotal').AsFloat)
    ]);
    memCupom.Lines.Add(Linha);

    Inc(ItemCont);
    dmConexao.qryGravarVenda.Next;
    end;

    memCupom.Lines.Add('----------------------------------------');

    dmConexao.qryGravarVenda.Close;
    dmConexao.qryGravarVenda.SQL.Clear;
    dmConexao.qryGravarVenda.SQL.Add('select * from PDV_Vendas where id_venda = :id');
    dmConexao.qryGravarVenda.Parameters.ParamByName('id').Value := AIdVenda;
    dmConexao.qryGravarVenda.Open;

    if not dmConexao.qryGravarVenda.IsEmpty then
    begin
      memCupom.Lines.Add(Format('TOTAL R$: %30s', [FormatFloat('#,##0.00', dmConexao.qryGravarVenda.FieldByName('valor_total').AsFloat)]));
      memCupom.Lines.Add(Format('VALOR PAGO R$: %25s', [FormatFloat('#,##0.00', dmConexao.qryGravarVenda.FieldByName('valor_pago').AsFloat)]));
      memCupom.Lines.Add(Format('TROCO R$: %30s', [FormatFloat('#,##0.00', dmConexao.qryGravarVenda.FieldByName('valor_troco').AsFloat)]));
    end;

    memCupom.Lines.Add('========================================');
    memCupom.Lines.Add('       OBRIGADO PELA PREFERENCIA!       ');
    memCupom.Lines.Add('========================================');
  end;
end.
